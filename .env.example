# ---------------------------------------------------------------------------
# GSC QA Automation - environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored and MUST NOT be committed.
# ---------------------------------------------------------------------------

# Marketing site (movie browsing). Default if unset.
BASE_URL=https://www.gsc.com.my

# Booking engine (showtimes, seat selection, checkout). Separate Angular app.
BOOKING_URL=https://epaymentwebapp.gsc.com.my

# Public showtime/movie XML API - used as the assertion oracle.
API_URL=https://epaymentapi.gsc.com.my

# ---------------------------------------------------------------------------
# OPTIONAL - GSC member credentials.
#
# Clicking a showtime redirects anonymous users to /login. Without credentials
# the booking-continuation tests assert the auth gate and SKIP the seat-map
# assertions (they do not fail). Supply a dedicated NON-PRODUCTION-VALUE test
# account to unlock the deeper assertions.
#
# NEVER put a real customer account here. NEVER complete a payment.
# ---------------------------------------------------------------------------
GSC_MOBILE=
GSC_PASSWORD=
