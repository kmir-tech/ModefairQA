{
  "name": "gsc-qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript end-to-end quality suite for Golden Screen Cinemas Malaysia (https://www.gsc.com.my)",
  "private": true,
  "license": "ISC",
  "scripts": {
    "postinstall": "playwright install --with-deps chromium",
    "install:browsers": "playwright install --with-deps",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:cross-browser": "playwright test --project=firefox --project=webkit",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:flake": "playwright test --project=chromium --repeat-each=3 --workers=1",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen https://www.gsc.com.my",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.2.5",
    "fast-xml-parser": "^5.11.0",
    "typescript": "^6.0.2"
  }
}
